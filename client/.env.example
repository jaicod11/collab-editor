# client/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Vite inlines these at BUILD time, not runtime. A deployed bundle carries
# whatever was set when `vite build` ran, so they must be present in the hosting
# platform's build environment (Vercel: Project → Settings → Environment
# Variables). Setting them afterwards has no effect until the next build.
#
# Neither value is secret — both are baked into the JavaScript every visitor
# downloads. Never put a token or key in a VITE_ variable.

# Local development (matches the default server port):
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000

# Production example — the Render backend's public origin:
#   VITE_API_URL=https://collab-editor-api.onrender.com/api
#   VITE_WS_URL=https://collab-editor-api.onrender.com
#
# VITE_WS_URL takes the https:// origin, not ws://. Socket.io derives the
# WebSocket scheme itself and needs the HTTP origin to negotiate the upgrade.
