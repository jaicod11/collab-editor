# server/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Template for server/.env — copy it and fill in real values:
#
#   cp server/.env.example server/.env
#
# server/.env is gitignored and must never be committed. Every key below is
# required unless marked optional; config/env.js validates them at startup and
# exits with a clear error if any required key is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Optional — defaults to 4000.
PORT=4000

# Optional — defaults to "development". Set to "production" when deploying.
NODE_ENV=development

# ── MongoDB (required) ───────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/collab-editor
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/collab-editor

# ── Redis (required) ─────────────────────────────────────────────────────────
# Local:    redis://localhost:6379
# Managed:  rediss://<user>:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ── JWT (required) ───────────────────────────────────────────────────────────
# Generate a strong random secret — never reuse the example value:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# config/env.js warns if this is shorter than 32 characters.
JWT_SECRET=replace_me_with_a_64_byte_random_hex_string

# Optional — defaults to "7d". Accepts any ms/zeit format ("15m", "12h", "7d").
JWT_EXPIRES=7d

# ── CORS / client origin (required) ──────────────────────────────────────────
# Origin allowed by both the Express CORS layer and the Socket.io handshake.
CLIENT_URL=http://localhost:5173
