# server/.env.local.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to server/.env.local to point the server at the LOCAL dev stack
# (infra/docker-compose.dev.yml) instead of the shared/production databases.
#
#   docker compose -f infra/docker-compose.dev.yml up -d
#   cp server/.env.local.example server/.env.local
#   npm --prefix server run dev
#
# .env.local is loaded AFTER .env and overrides it, so the production values in
# .env stay put and are simply not used while this file exists. It is gitignored.
#
# Ports are the dev stack's non-default ones so a local run can never be
# mistaken for — or collide with — a real deployment.

MONGODB_URI=mongodb://127.0.0.1:27018/collab-editor?directConnection=true
REDIS_URL=redis://127.0.0.1:6380

# Local-only signing key. Not a secret; never reuse it anywhere real.
JWT_SECRET=local-development-only-jwt-secret-not-for-any-real-deployment-0000
